# Application
APP_ENV=development
LOG_LEVEL=INFO

# Document ingestion (character counts)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j
NEO4J_VECTOR_INDEX_NAME=chunk_embedding_index
VECTOR_SIMILARITY_FUNCTION=cosine
RETRIEVAL_TOP_K=5

# Hybrid GraphRAG retrieval
HYBRID_DEFAULT_TOP_K=5
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_GRAPH_WEIGHT=0.3
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITIES=50
GRAPH_MAX_RELATIONSHIPS=100
GRAPH_MAX_SUPPORTING_CHUNKS=20

# Providers: openai or azure_openai. LLM_PROVIDER controls graph extraction.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1536

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (chat settings are used for extraction when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=replace-with-supported-api-version
AZURE_OPENAI_CHAT_DEPLOYMENT=replace-with-chat-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=replace-with-embedding-deployment-name
