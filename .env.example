# Application
APP_ENV=development
LOG_LEVEL=INFO

# Document ingestion (character counts)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j

# LLM provider: openai or azure_openai
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (required only when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=replace-with-supported-api-version
AZURE_OPENAI_CHAT_DEPLOYMENT=replace-with-chat-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=replace-with-embedding-deployment-name
